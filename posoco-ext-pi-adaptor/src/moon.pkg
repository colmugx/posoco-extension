import {
  "colmugx/posoco",
  "colmugx/posoco/kernel",
  "colmugx/posoco/runtime",
  "moonbitlang/core/async/js_async",
  "moonbitlang/core/json",
}

import {
  "moonbitlang/core/async",
} for "wbtest"

supported_targets = "js"

pkgtype(kind: "foreign_library")

options(
  "allow-experimental-packages": [
    "moonbitlang/core/async",
    "moonbitlang/core/async/js_async",
  ],
  link: { "js": { "format": "esm" } },
)
