name = "colmugx/posoco-ext-pi-adaptor"

version = "0.1.0"

preferred_target = "js"

supported_targets = "js"

import {
  "colmugx/posoco@0.14.2",
  "moonbitlang/async@0.21.0",
}

readme = "README.mbt.md"

repository = "https://github.com/colmugx/posoco-extension"

license = "Apache-2.0"

keywords = [
  "posoco",
  "pi",
  "extension",
  "compatibility",
  "tool-provider",
  "javascript",
]

description = "Posoco runtime adaptor for loading Pi ecosystem extensions on the JavaScript target"

source = "src"
