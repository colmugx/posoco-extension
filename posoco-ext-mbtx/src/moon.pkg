import {
  "colmugx/posoco-ext-mbtx/protocol",
  "moonbitlang/core/async",
  "moonbitlang/core/async/aqueue",
  "moonbitlang/core/async/fs",
  "moonbitlang/core/async/js_async",
  "moonbitlang/core/async/process",
  "moonbitlang/core/env",
  "posoco/devkit",
  "colmugx/posoco",
  "moonbitlang/core/json",
  "moonbitlang/core/encoding/utf8",
}

options(
    "allow-experimental-packages": [ "moonbitlang/core/async", "moonbitlang/core/async/aqueue", "moonbitlang/core/async/fs", "moonbitlang/core/async/js_async", "moonbitlang/core/async/process" ],
targets: {
    "process.native.mbt": [ "native" ],
    "toolchain_platform.native.mbt": [ "native" ],
    "toolchain_platform.js.mbt": [ "js" ],
    "process.js.mbt": [ "js" ],
    "filesystem.native.mbt": [ "native" ],
    "filesystem.js.mbt": [ "js" ],
    "runtime_test.mbt": [ "native", "js" ],
    "fixture_native_test.mbt": [ "native" ],
    "fixture_js_test.mbt": [ "js" ],
  },
)

supported_targets = "native + js"

// Target-specific native/JS dependencies are intentionally unused on the other backend.

warnings = "-unused_package"
