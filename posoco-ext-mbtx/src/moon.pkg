import {
  "colmugx/posoco-ext-mbtx/protocol",
  "moonbitlang/core/async",
  "moonbitlang/core/async/aqueue",
  "moonbitlang/core/env",
  "colmugx/posoco",
  "moonbitlang/core/json",
  "moonbitlang/core/encoding/utf8",
}

// Per-backend process and filesystem: native shells out through @process and
// async/fs, js uses the Bun FFI twins.
#cfg(target = "native")
import {
  "moonbitlang/core/async/fs",
  "moonbitlang/core/async/process",
}

#cfg(target = "js")
import {
  "moonbitlang/core/async/js_async",
}

options(
  "allow-experimental-packages": [
    "moonbitlang/core/async",
    "moonbitlang/core/async/aqueue",
    "moonbitlang/core/async/fs",
    "moonbitlang/core/async/js_async",
    "moonbitlang/core/async/process",
  ],
  targets: {
    "process.native.mbt": [ "native" ],
    "toolchain_platform.native.mbt": [ "native" ],
    "toolchain_platform.js.mbt": [ "js" ],
    "process.js.mbt": [ "js" ],
    "filesystem.native.mbt": [ "native" ],
    "filesystem.js.mbt": [ "js" ],
    "runtime_test.mbt": [ "native", "js" ],
    "fixture_native_test.mbt": [ "native" ],
    "process_eof_native_test.mbt": [ "native" ],
    "fixture_js_test.mbt": [ "js" ],
  },
)

supported_targets = "native + js"
