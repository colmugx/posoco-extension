import {
  "colmugx/posoco-ext-mbtx/protocol",
  "colmugx/posoco-ext-mbtx/sdk",
  "colmugx/fuwaroid",
  "moonbitlang/core/async/aqueue",
  "moonbitlang/core/async/stdio" @system_stdio,
  "moonbitlang/core/async",
}

supported_targets = "native + wasm"

// The registry loop is a fuwaroid actor: it spawns on posoco's
// `moonbitlang/core/async` stack, so the invocation scope is a core task group.

options(
  "allow-experimental-packages": [
    "moonbitlang/core/async",
    "moonbitlang/core/async/aqueue",
    "moonbitlang/core/async/stdio",
  ],
)
