import {
  "colmugx/posoco-ext-mbtx/protocol",
  "colmugx/posoco-ext-mbtx/sdk",
  "colmugx/fuwaroid",
  "moonbitlang/core/async",
  "moonbitlang/core/async/aqueue",
  "moonbitlang/core/async/stdio" @system_stdio,
}

supported_targets = "native + wasm"

options(
  "allow-experimental-packages": [ "moonbitlang/core/async", "moonbitlang/core/async/aqueue", "moonbitlang/core/async/stdio" ],
)
