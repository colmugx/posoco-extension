import {
  "moonbitlang/core/encoding/utf8",
  "colmugx/posoco",
  "colmugx/posoco-ext-permission" @permission,
  "posoco/devkit",
  "moonbit-community/yaml",
  "moonbitlang/core/debug",
  "moonbitlang/core/json",
}

// async/fs backs the filesystem probe on native and wasm; the js twin uses
// node:fs.
#cfg(not(target = "js"))
import {
  "moonbitlang/core/async/fs",
}

import {
  "moonbitlang/core/async",
} for "wbtest"

// `async test` requires the root `moonbitlang/core/async` import but never names it
// through the alias, so js/wasm checks report it unused.

warnings = "-unused_package"

options(
  "allow-experimental-packages": [ "moonbitlang/core/async", "moonbitlang/core/async/fs" ],
  targets: {
    "kind_fs.js.mbt": [ "js" ],
    "kind_fs.native.mbt": [ "native", "wasm" ],
  },
)
