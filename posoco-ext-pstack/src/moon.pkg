import {
  "colmugx/posoco",
  "colmugx/posoco-ext-skills" @skills,
  "colmugx/posoco-ext-kind" @kind,
  "colmugx/posoco-ext-workspace" @workspace,
  "posoco/devkit",
  "posoco/kit-events" @kit_events,
}

import {
  "moonbitlang/core/async",
  "colmugx/posoco-ext-permission" @permission,
} for "wbtest"

options(
  "allow-experimental-packages": [ "moonbitlang/core/async" ],
  // Native-only IO tests: the real-assets discovery test needs a host
  // filesystem; every other target is covered by the fake-fs suite.
  targets: { "assets_discovery_wbtest.mbt": [ "native" ] },
)
