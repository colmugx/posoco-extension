import {
  "colmugx/posoco",
  "colmugx/posoco-ext-lazytools" @lazytools,
  "moonbitlang/core/async",
  "moonbitlang/core/async/js_async",
  "moonbitlang/core/async/process",
}

warnings = "-unused_package"

options(
    "allow-experimental-packages": [ "moonbitlang/core/async", "moonbitlang/core/async/js_async", "moonbitlang/core/async/process" ],
targets: {
    "posoco_ext_rtk.native.mbt": [ "native", "wasm" ],
    "posoco_ext_rtk.js.mbt": [ "js" ],
  },
)
