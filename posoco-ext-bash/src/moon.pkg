import {
  "colmugx/posoco",
  "colmugx/posoco/kernel",
  "colmugx/posoco/runtime",
  "colmugx/posoco-devkit" @devkit,
  "moonbitlang/async",
  "moonbitlang/async/process",
  "moonbitlang/async/js_async",
}

import {
  "moonbitlang/async",
  "moonbitlang/async/fs",
  "moonbitlang/core/env",
} for "wbtest"

supported_targets = "+native +js"

options(
  targets: {
    "posoco_ext_bash.js.mbt": [ "js" ],
    "posoco_ext_bash.native.mbt": [ "native" ],
    "runtime_adaptor.js.mbt": [ "js" ],
    "runtime_adaptor.native.mbt": [ "native" ],
    "runtime_adaptor_wbtest.mbt": [ "native" ],
    "bash_native_path_wbtest.mbt": [ "native" ],
  },
)
