import {
  "colmugx/posoco",
  "colmugx/posoco/kernel",
  "colmugx/posoco/runtime",
  "posoco/devkit",
  "moonbitlang/core/async",
  "moonbitlang/core/async/process",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/async/js_async",
}

import {
  "moonbitlang/core/async",
  "moonbitlang/core/async/fs",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "posoco/devkit/testkit" @tk,
} for "wbtest"

warnings = "-unused_package"

supported_targets = "+native +js +wasm"

options(
    "allow-experimental-packages": [ "moonbitlang/core/async", "moonbitlang/core/async/fs", "moonbitlang/core/async/js_async", "moonbitlang/core/async/process" ],
targets: {
    "posoco_ext_bash.js.mbt": [ "js" ],
    "posoco_ext_bash.native.mbt": [ "native", "wasm" ],
    "shell_cancel_wbtest.mbt": [ "native" ],
    "bash_native_path_wbtest.mbt": [ "native" ],
  },
)
