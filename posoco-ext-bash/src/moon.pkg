import {
  "colmugx/posoco",
  "moonbitlang/async",
  "moonbitlang/async/js_async",
  "moonbitlang/async/process",
  "moonbitlang/core/json",
}

warnings = "-unused_package"

options(
  targets: {
    "posoco_ext_bash.mbt": [ "native" ],
    "posoco_ext_bash_js.mbt": [ "js" ],
    "posoco_ext_bash_shared.mbt": [ "native", "js" ],
    "fallback.mbt": [ "wasm-gc" ],
    "posoco_ext_bash_wbtest.mbt": [ "native" ],
  },
)
