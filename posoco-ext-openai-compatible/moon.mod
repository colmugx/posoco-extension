name = "colmugx/posoco-ext-openai-compatible"

version = "0.1.0"

import {
  "colmugx/posoco@0.10.1",
  "colmugx/posoco-devkit@0.1.0",
  "colmugx/posoco-kit-chat-completions@0.1.0",
  "colmugx/posoco-ext-llm@0.1.0",
  "colmugx/posoco-ext-oauth@0.1.0",
  "moonbitlang/async@0.20.4",
}

readme = "README.mbt.md"

license = "Apache-2.0"

keywords = [
  "posoco",
  "openai-compatible",
  "chat-completions",
  "llm",
  "model-port",
  "streaming",
  "custom-provider",
]

description = "Posoco OpenAI-compatible extension — generic /chat/completions ModelPort for any custom provider endpoint"

source = "src"
