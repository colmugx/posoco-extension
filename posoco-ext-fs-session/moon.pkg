import {
  "colmugx/posoco",
  "colmugx/posoco-kit-model-management" @modelmgmt,
  "posoco/devkit",
  "moonbitlang/core/async",
  "moonbitlang/core/async/fs",
  "moonbitlang/core/async/io",
  "moonbitlang/core/async/js_async",
  "moonbitlang/core/debug",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/json",
  "moonbitlang/core/string",
  "moonbitlang/x/crypto",
  "moonbitlang/x/fs" @xfs,
}

warnings = "-unused_package"

options(
    "allow-experimental-packages": [ "moonbitlang/core/async", "moonbitlang/core/async/fs", "moonbitlang/core/async/io", "moonbitlang/core/async/js_async" ],
targets: {
    "jsonl_session.mbt": [ "native", "wasm" ],
    "jsonl_session.js.mbt": [ "js" ],
    "session_id_test.mbt": [ "native", "js" ],
    "companion_path_test.mbt": [ "native", "js" ],
    "list_ids.js.mbt": [ "js" ],
    "project_dir_test.mbt": [ "native" ],
    "session_summary_test.mbt": [ "native" ],
    "session_cwd_test.mbt": [ "native" ],
    "name_command_test.mbt": [ "native" ],
    "jsonl_session_test.mbt": [ "native" ],
    "compact_replay_wbtest.mbt": [ "native" ],
    "jsonl_session_js_test.mbt": [ "js" ],
    "list_ids_test.mbt": [ "native" ],
    "model_selection_test.mbt": [ "native" ],
  },
)
