import {
  "colmugx/posoco",
  "colmugx/posoco-kit-model-management" @modelmgmt,
  "posoco/devkit",
  "posoco/kit-events" @kit_events,
  "moonbitlang/async",
  "moonbitlang/core/debug",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/json",
  "moonbitlang/core/string",
  "moonbitlang/x/crypto",
}

// The native+wasm store owns the async fs stack; jsonl_session.js.mbt uses the
// node:fs envelope and x/fs instead.
#cfg(not(target = "js"))
import {
  "moonbitlang/async/fs" @fs,
  "moonbitlang/async/io" @io,
  "moonbitlang/x/fs" @xfs,
}

// `async test` requires the root `moonbitlang/async` import but never names it
// through the alias, so every target reports it unused.
warnings = "-unused_package"

options(
  targets: {
    "jsonl_session.mbt": [ "native", "wasm" ],
    "jsonl_session.js.mbt": [ "js" ],
    "session_id_test.mbt": [ "native", "js" ],
    "companion_path_test.mbt": [ "native", "js" ],
    "list_ids.js.mbt": [ "js" ],
    "project_dir_test.mbt": [ "native" ],
    "session_summary_test.mbt": [ "native" ],
    "session_cwd_test.mbt": [ "native" ],
    "name_command_test.mbt": [ "native" ],
    "jsonl_session_test.mbt": [ "native" ],
    "compact_replay_wbtest.mbt": [ "native" ],
    "jsonl_session_js_test.mbt": [ "js" ],
    "list_ids_test.mbt": [ "native" ],
    "model_selection_test.mbt": [ "native" ],
  },
)
