import {
  "colmugx/posoco",
  "moonbitlang/async",
  "moonbitlang/async/fs",
  "moonbitlang/async/io",
  "moonbitlang/async/js_async",
  "moonbitlang/core/json",
  "moonbitlang/x/fs" @xfs,
}

warnings = "-unused_package"

options(
  targets: {
    "jsonl_session.mbt": [ "native" ],
    "jsonl_session.js.mbt": [ "js" ],
    "jsonl_session_serde.mbt": [ "native", "js" ],
    "session_id.mbt": [ "native", "js" ],
    "manifest.mbt": [ "native", "js" ],
    "session_id_test.mbt": [ "native", "js" ],
    "jsonl_session_test.mbt": [ "native" ],
    "jsonl_session_js_test.mbt": [ "js" ],
  },
)
