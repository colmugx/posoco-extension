import {
  "colmugx/posoco",
  "moonbitlang/core/debug",
}

import {
  "moonbitlang/core/async",
  "posoco/devkit/testkit" @tk,
} for "wbtest"

// `async test` needs the root `moonbitlang/core/async` import without ever
// naming it, so js/wasm checks report it as unused.

warnings = "-unused_package"

options(
  "allow-experimental-packages": [ "moonbitlang/core/async" ],
)
