import {
  "colmugx/posoco",
  "moonbitlang/core/debug",
}

import {
  "moonbitlang/async",
} for "test"

import {
  "moonbitlang/async",
  "colmugx/posoco/kernel",
  "posoco/devkit/testkit" @tk,
} for "wbtest"

// The testkit import above is only exercised by native-only white-box
// files, so `--target js` checks would report it as unused.

warnings = "-unused_package"

options(
  targets: { "posoco_ext_todo_wbtest.mbt": [ "native" ] },
)
