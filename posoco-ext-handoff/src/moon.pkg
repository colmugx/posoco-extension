import {
  "colmugx/posoco",
  "moonbitlang/core/debug",
  "moonbitlang/core/json",
  "moonbitlang/core/async/fs",
}

warnings = "-unused_package"

import {
  "moonbitlang/core/async",
} for "wbtest"

// The only HandoffStore impls live in the native/js gated files above, so the
// package has no DefaultHandoffStore impl on wasm/wasm-gc. Declare the real
// backend set so default-target checks skip instead of failing on the trait.

options(
    "allow-experimental-packages": [ "moonbitlang/core/async", "moonbitlang/core/async/fs" ],
targets: {
    "default_store.native.mbt": [ "native", "wasm" ],
    "default_store.js.mbt": [ "js" ],
  },
)
