import {
  "colmugx/posoco",
  "colmugx/posoco/types",
  "colmugx/posoco-devkit" @devkit,
  "colmugx/posoco-ext-oauth" @oauth,
  "colmugx/posoco-kit-chat-completions" @chatkit,
  "moonbitlang/async",
  "moonbitlang/core/debug",
}

import {
  "moonbitlang/async",
} for "wbtest"

options(
  targets: {
    // Production code compiles on every backend. Only the white-box tests are
    // native-only because they exercise async login/refresh paths.
    "router_wbtest.mbt": [ "native" ],
    "transient_retry_wbtest.mbt": [ "native" ],
    "command_model_wbtest.mbt": [ "native" ],
    "command_model_pick_wbtest.mbt": [ "native" ],
    "command_model_quick_wbtest.mbt": [ "native" ],
    "command_login_wbtest.mbt": [ "native" ],
  },
)
