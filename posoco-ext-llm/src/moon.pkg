import {
  "colmugx/posoco",
  "colmugx/posoco-kit-model-management" @modelmgmt,
  "colmugx/posoco-kit-provider" @provider,
  "colmugx/posoco/types",
  "posoco/devkit",
  "posoco/ext-oauth" @oauth,
  "posoco/kit-chat-completions" @chatkit,
  "posoco/kit-events" @kit_events,
  "moonbitlang/core/async",
  "moonbitlang/core/async/http",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/json",
  "moonbitlang/core/string",
  "moonbitlang/core/debug",
}

import {
  "moonbitlang/core/async",
} for "wbtest"

// The white-box testkit is only exercised by native-only tests.
#cfg(target = "native")
import {
  "posoco/devkit/testkit" @tk,
} for "wbtest"

options(
  "allow-experimental-packages": [
    "moonbitlang/core/async",
    "moonbitlang/core/async/http",
  ],
  targets: {
    // Production code compiles on every backend. Only the white-box tests are
    // native-only because they exercise async login/refresh paths.
    "router_wbtest.mbt": [ "native" ],
    "models_dev_wbtest.mbt": [ "native" ],
    "transient_retry_wbtest.mbt": [ "native" ],
    "command_model_wbtest.mbt": [ "native" ],
    "command_model_pick_wbtest.mbt": [ "native" ],
    "command_model_quick_wbtest.mbt": [ "native" ],
    "command_login_wbtest.mbt": [ "native" ],
    "command_decision_wbtest.mbt": [ "native" ],
    "picker_catalog_wbtest.mbt": [ "native" ],
  },
)
