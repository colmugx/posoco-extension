import {
  "moonbitlang/core/encoding/utf8",
  "colmugx/posoco",
  "moonbitlang/core/async",
  "moonbitlang/core/async/fs",
  "moonbitlang/core/async/os_error",
  "moonbitlang/core/debug",
}

// @fs backs fs_port.native.mbt on native+wasm. On js it is unused (the js
// twin uses node:fs FFI) but must stay imported; silence the noise.

warnings = "-unused_package"

import {
  "moonbitlang/core/async",
  "moonbitlang/core/async/fs",
  "moonbitlang/core/async/types",
} for "wbtest"

options(
    "allow-experimental-packages": [ "moonbitlang/core/async", "moonbitlang/core/async/fs", "moonbitlang/core/async/os_error", "moonbitlang/core/async/types" ],
"native-stub": [ "fs_atomic_test_stub.c" ],
  targets: {
    "fs_atomic_native_wbtest.mbt": [ "native" ],
    "fs_port.native.mbt": [ "native", "wasm" ],
    "fs_port.js.mbt": [ "js" ],
  },
)
