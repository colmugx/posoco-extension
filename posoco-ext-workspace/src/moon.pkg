import {
  "colmugx/posoco",
  "moonbitlang/async",
  "moonbitlang/async/fs",
  "moonbitlang/async/os_error",
  "moonbitlang/core/debug",
}

// @fs backs fs_port.native.mbt on native+wasm. On js it is unused (the js
// twin uses node:fs FFI) but must stay imported; silence the noise.

warnings = "-unused_package"

import {
  "moonbitlang/async",
  "moonbitlang/async/fs",
  "moonbitlang/async/types",
} for "wbtest"

options(
  "native-stub": [ "fs_atomic_test_stub.c" ],
  targets: {
    "fs_atomic_native_wbtest.mbt": [ "native" ],
    "fs_port.native.mbt": [ "native", "wasm" ],
    "fs_port.js.mbt": [ "js" ],
  },
)
