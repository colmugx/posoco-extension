import {
  "moonbitlang/core/debug",
}

// async/fs backs the native+wasm fs port; the js twin uses node:fs FFI.
#cfg(not(target = "js"))
import {
  "moonbitlang/async",
  "moonbitlang/async/fs" @fs,
  "moonbitlang/async/os_error" @os_error,
}

import {
  "moonbitlang/async",
  "moonbitlang/async/fs",
} for "wbtest"

#cfg(target = "native")
import {
  "moonbitlang/async/types" @types,
} for "wbtest"

// `async test` requires the root `moonbitlang/async` import and a test import
// cannot be target-gated, so js checks report it unused.
warnings = "-unused_package"

options(
  "native-stub": [ "fs_atomic_test_stub.c" ],
  targets: {
    "fs_atomic_native_wbtest.mbt": [ "native" ],
    "fs_port.native.mbt": [ "native", "wasm" ],
    "fs_port.js.mbt": [ "js" ],
  },
)
