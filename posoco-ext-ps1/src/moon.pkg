import {
  "colmugx/posoco",
  "colmugx/posoco/kernel",
  "posoco/devkit",
  "moonbitlang/core/async",
}

// Each backend compiles one execute path: native+wasm through @process and
// async/io, js through the Bun FFI twin.
#cfg(any(target = "native", target = "wasm"))
import {
  "moonbitlang/core/async/process",
  "moonbitlang/core/env",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/buffer",
}

#cfg(target = "js")
import {
  "moonbitlang/core/async/js_async",
}

import {
  "moonbitlang/core/async",
} for "wbtest"

options(
  "allow-experimental-packages": [
    "moonbitlang/core/async",
    "moonbitlang/core/async/io",
    "moonbitlang/core/async/js_async",
    "moonbitlang/core/async/process",
  ],
  targets: {
    "posoco_ext_ps1.js.mbt": [ "js" ],
    "posoco_ext_ps1.native.mbt": [ "native", "wasm" ],
    "platform.js.mbt": [ "js" ],
    "platform.native.mbt": [ "native", "wasm" ],
    "posoco_ext_ps1_wbtest.mbt": [ "native" ],
  },
)
