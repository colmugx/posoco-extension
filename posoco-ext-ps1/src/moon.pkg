import {
  "colmugx/posoco",
  "colmugx/posoco/kernel",
  "posoco/devkit",
  "moonbitlang/core/async",
  "moonbitlang/core/async/process",
  "moonbitlang/core/async/js_async",
  "moonbitlang/core/async/io",
  "moonbitlang/core/json",
  "moonbitlang/core/env",
  "moonbitlang/core/buffer",
}

import {
  "moonbitlang/core/async",
} for "wbtest"

warnings = "-unused_package"

options(
    "allow-experimental-packages": [ "moonbitlang/core/async", "moonbitlang/core/async/io", "moonbitlang/core/async/js_async", "moonbitlang/core/async/process" ],
targets: {
    "posoco_ext_ps1.js.mbt": [ "js" ],
    "posoco_ext_ps1.native.mbt": [ "native", "wasm" ],
    "platform.js.mbt": [ "js" ],
    "platform.native.mbt": [ "native", "wasm" ],
    "posoco_ext_ps1_wbtest.mbt": [ "native" ],
  },
)
