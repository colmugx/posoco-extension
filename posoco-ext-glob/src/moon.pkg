import {
  "colmugx/posoco",
  "colmugx/posoco-devkit" @devkit,
  "moonbitlang/async/fs",
  "moonbitlang/core/json",
}

// No per-file targets: each file uses #cfg attributes for conditional
// compilation. All files compile on every target; inactive #cfg branches
// are simply excluded by the compiler.

import {
  "moonbitlang/async",
} for "wbtest"

options(
  targets: {
    "posoco_ext_glob.js.mbt": [ "js" ],
    "posoco_ext_glob.native.mbt": [ "native" ],
  },
)
