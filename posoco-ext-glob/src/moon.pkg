warnings = "-unused_package"

import {
  "colmugx/posoco",
  "posoco/devkit",
  "moonbitlang/async/fs",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/json",
}

import {
  "moonbitlang/async",
} for "wbtest"

options(
  targets: {
    "posoco_ext_glob.js.mbt": [ "js" ],
    "posoco_ext_glob.native.mbt": [ "native", "wasm" ],
    "posoco_ext_glob_native_wbtest.mbt": [ "native" ],
  },
)
