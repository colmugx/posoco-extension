import {
  "colmugx/posoco",
  "posoco/devkit",
  "colmugx/posoco-kit-rate-limit" @ratelimit,
  "posoco/kit-events" @kit_events,
  "colmugx/posoco-kit-responses" @responses,
  "posoco/ext-llm" @llm,
  "posoco/ext-oauth" @oauth,
  "moonbitlang/async",
  "moonbitlang/async/http",
  "moonbitlang/core/json",
  "moonbitlang/core/env",
  "moonbitlang/core/random",
  "moonbitlang/core/string",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/x/codec/base64",
  "moonbitlang/x/crypto",
  "moonbitlang/x/uuid",
}

// Native-only transports: async/fs (plus the wasm cache dump), the WebSocket
// client and the gzip codec. The js WebSocket twin uses the Bun FFI.
#cfg(not(target = "js"))
import {
  "moonbitlang/async/fs",
}

#cfg(target = "native")
import {
  "moonbitlang/async/websocket",
  "moonbit-community/flate/gzip",
}

#cfg(target = "js")
import {
  "moonbitlang/async/js_async",
}

warnings = "-unused_async-struct_never_constructed-unused_field"

options(
  "native-stub": [ "identity_stub.c" ],
  targets: {
    "identity.js.mbt": [ "js" ],
    "identity.native.mbt": [ "native" ],
    "compression.js.mbt": [ "js" ],
    "compression.native.mbt": [ "native" ],
    "compression_other.mbt": [ "wasm" ],
    "compression_js_wbtest.mbt": [ "js" ],
    "compression_native_wbtest.mbt": [ "native" ],
    "codex_ws_native.mbt": [ "native" ],
    "codex_ws_js.mbt": [ "js" ],
    "codex_ws_other.mbt": [ "wasm" ],
    "codex_ws_native_wbtest.mbt": [ "native" ],
    "codex_ws_js_wbtest.mbt": [ "js" ],
    "version_file_cache.native.mbt": [ "native" ],
    "version_file_cache.js.mbt": [ "js" ],
    "version_file_cache_fallback.mbt": [ "wasm" ],
    "version_file_cache_wbtest.mbt": [ "native" ],
    "version_file_cache_js_wbtest.mbt": [ "js" ],
    "posoco_ext_openai_wbtest.mbt": [ "native" ],
    "codex_version_wbtest.mbt": [ "native" ],
    "compact_transport_wbtest.mbt": [ "native" ],
    "latest_contract_wbtest.mbt": [ "native" ],
    "compact_security_wbtest.mbt": [ "native" ],
    "codex_quota_wbtest.mbt": [ "native" ],
    "codex_usage_wbtest.mbt": [ "native" ],
    "codex_status_live_wbtest.mbt": [ "native" ],
    "quota_status_wbtest.mbt": [ "native" ],
    "web_search_config_wbtest.mbt": [ "native" ],
    "web_search_response_wbtest.mbt": [ "native" ],
    "intelligence_metrics_wbtest.mbt": [ "native" ],
  },
)

import {
  "posoco/kit-chat-completions" @chatkit,
} for "wbtest"

#cfg(target = "native")
import {
  "moonbitlang/async/socket",
  "posoco/devkit/testkit" @tk,
} for "wbtest"
