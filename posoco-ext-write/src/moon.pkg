import {
  "colmugx/posoco",
  "posoco/devkit",
  "moonbitlang/core/encoding/utf8",
}

// async/fs backs the native writer; the js twin uses node:fs and only needs
// the JSON wire vocabulary.
#cfg(not(target = "js"))
import {
  "moonbitlang/core/async/fs",
}

#cfg(target = "js")
import {
  "moonbitlang/core/json",
}

import {
  "moonbitlang/core/async",
  "colmugx/posoco/kernel",
} for "wbtest"

options(
  "allow-experimental-packages": [
    "moonbitlang/core/async",
    "moonbitlang/core/async/fs",
  ],
  targets: {
    "posoco_ext_write.js.mbt": [ "js" ],
    "posoco_ext_write.native.mbt": [ "native", "wasm" ],
  },
)
