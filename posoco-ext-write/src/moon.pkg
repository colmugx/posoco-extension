import {
  "colmugx/posoco",
  "posoco/devkit",
  "moonbitlang/async/fs",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/json",
}

import {
  "moonbitlang/async",
  "colmugx/posoco/kernel",
} for "wbtest"

warnings = "-unused_package"

options(
  targets: {
    "posoco_ext_write.js.mbt": [ "js" ],
    "posoco_ext_write.native.mbt": [ "native", "wasm" ],
  },
)
