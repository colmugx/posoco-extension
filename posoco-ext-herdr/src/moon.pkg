import {
  "colmugx/posoco",
  "moonbitlang/core/env",
  "moonbitlang/core/encoding/utf8",
}

// @env and @utf8 are used by herdr_native.mbt only but must stay imported
// package-wide; js and wasm legitimately see them as unused.

warnings = "-unused_package"

supported_targets = "+native +js"

options(
  "native-stub": ["herdr_system_stub.c"],
  targets: {
    "herdr_native.mbt": [ "native" ],
    "herdr_js.mbt": [ "js" ],
    "herdr_gate_wbtest.mbt": [ "native", "js" ],
    "herdr_shell_quote_wbtest.mbt": [ "native" ],
  },
)
