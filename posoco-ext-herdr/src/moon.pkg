import {
  "colmugx/posoco",
}

// Environment and UTF-8 decoding back the native reporter only.
#cfg(target = "native")
import {
  "moonbitlang/core/env",
  "moonbitlang/core/encoding/utf8",
}

import {
  "moonbitlang/core/async",
} for "wbtest"

options(
  "allow-experimental-packages": [ "moonbitlang/core/async" ],
  "native-stub": [ "herdr_system_stub.c" ],
  targets: {
    "herdr_native.mbt": [ "native" ],
    "herdr_js.mbt": [ "js" ],
    "herdr_gate_wbtest.mbt": [ "native", "js" ],
    "herdr_shell_quote_wbtest.mbt": [ "native" ],
    "herdr_windows_wbtest.mbt": [ "native" ],
  },
)
