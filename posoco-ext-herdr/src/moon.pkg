import {
  "colmugx/posoco",
  "moonbitlang/core/env",
  "moonbitlang/core/encoding/utf8",
}

import {
  "moonbitlang/core/async",
} for "wbtest"

// @env and @utf8 are used by herdr_native.mbt only but must stay imported
// package-wide; js and wasm legitimately see them as unused. The wbtest
// import is for `async test` on the shutdown-release case.

warnings = "-unused_package"

options(
    "allow-experimental-packages": [ "moonbitlang/core/async" ],
"native-stub": [ "herdr_system_stub.c" ],
  targets: {
    "herdr_native.mbt": [ "native" ],
    "herdr_js.mbt": [ "js" ],
    "herdr_gate_wbtest.mbt": [ "native", "js" ],
    "herdr_shell_quote_wbtest.mbt": [ "native" ],
    "herdr_windows_wbtest.mbt": [ "native" ],
  },
)
