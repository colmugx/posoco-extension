import {
  "colmugx/posoco",
  "posoco/kit-events" @kit_events,
  "colmugx/fuwaroid",
  "moonbitlang/core/async" @core_async,
  "moonbitlang/core/debug",
}

import {
  "colmugx/posoco",
  "posoco/kit-events" @kit_events,
  "colmugx/fuwaroid",
  "moonbitlang/core/async" @core_async,
  "posoco/devkit/testkit" @tk,
} for "wbtest"

// The testkit import above is only exercised by native-only white-box files,
// so `--target js` checks would report it as unused.

warnings = "-unused_package"

options(
  "allow-experimental-packages": [ "moonbitlang/core/async" ],
  targets: { "rate_limit_guard_wbtest.mbt": [ "native" ] },
)
