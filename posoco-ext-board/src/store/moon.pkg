import {
  "colmugx/posoco-ext-board/domain",
  "moonbitlang/core/debug",
  "moonbitlang/core/json",
}

// The native journal twins are the only async/fs, core-async and utf8 users;
// the js twins go through @node_fs.
#cfg(target = "native")
import {
  "moonbitlang/core/async",
  "moonbitlang/core/async/fs",
  "moonbitlang/core/encoding/utf8",
}

#cfg(target = "js")
import {
  // `async test` needs the core-async import in the js test namespace; the
  // js source files themselves go through @node_fs and never name it.
  "moonbitlang/core/async",
  "colmugx/posoco-ext-board/internal/storage" @node_fs,
}

#cfg(target = "native")
import {
  "moonbitlang/core/async",
} for "wbtest"

#cfg(target = "js")
import {
  "colmugx/posoco-ext-board/testkit/node_fs" @fixtures,
} for "wbtest"

supported_targets = "+native +js"

// `async test` needs the core-async import in the test namespace; the aliased
// per-target `import` above already covers the source files, so no unaliased
// root import is needed (that duplication is what the checker warns about).

warnings = "-unused_package"

options(
  "allow-experimental-packages": [
    "moonbitlang/core/async",
    "moonbitlang/core/async/fs",
  ],
  "native-stub": [ "truncate_stub.c" ],
  targets: {
    "file.native.mbt": [ "native" ],
    "file.js.mbt": [ "js" ],
    "file_js_wbtest.mbt": [ "js" ],
    "file_native_wbtest.mbt": [ "native" ],
    "expansion_native_wbtest.mbt": [ "native" ],
  },
)
