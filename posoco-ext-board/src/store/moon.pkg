import {
  "colmugx/posoco-ext-board/domain",
  "moonbitlang/core/async",
  "moonbitlang/core/debug",
  "moonbitlang/core/json",
}

// The native journal twins are the only async/fs, core-async and utf8 users;
// the js twins go through @node_fs.
#cfg(target = "native")
import {
  "moonbitlang/core/async/fs",
  "moonbitlang/core/async" @core_async,
  "moonbitlang/core/encoding/utf8",
}

#cfg(target = "js")
import {
  "colmugx/posoco-ext-board/internal/storage" @node_fs,
}

#cfg(target = "native")
import {
  "moonbitlang/core/async" @core_async,
} for "wbtest"

#cfg(target = "js")
import {
  "colmugx/posoco-ext-board/testkit/node_fs" @fixtures,
} for "wbtest"

supported_targets = "+native +js"

// `async test` requires the root `moonbitlang/core/async` import but never names it
// through the alias, and a test import cannot be target-gated.

warnings = "-unused_package"

options(
  "allow-experimental-packages": [ "moonbitlang/core/async", "moonbitlang/core/async/fs" ],
  "native-stub": [ "truncate_stub.c" ],
  targets: {
    "file.native.mbt": [ "native" ],
    "file.js.mbt": [ "js" ],
    "file_js_wbtest.mbt": [ "js" ],
    "file_native_wbtest.mbt": [ "native" ],
    "expansion_native_wbtest.mbt": [ "native" ],
  },
)
