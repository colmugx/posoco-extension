import {
  "colmugx/posoco-ext-board/coordinator",
  "colmugx/posoco-ext-board/domain",
  "colmugx/posoco-ext-board/protocol",
  "colmugx/posoco-ext-board/store",
  "moonbitlang/core/async" @core_async,
  "moonbitlang/core/debug",
}

import {
  "colmugx/posoco-ext-board/client",
  "colmugx/posoco-ext-board/domain",
  "colmugx/posoco-ext-board/protocol",
  "colmugx/posoco-ext-board/store",
  "moonbitlang/core/async" @core_async,
} for "test"

import {
  "moonbitlang/core/async/aqueue",
  "moonbitlang/core/async" @core_async,
} for "wbtest"

// No transport imports and no per-target sources: the backend itself is
// target-neutral and runs wherever its module dependencies run.

supported_targets = "+native +js"

options(
  "allow-experimental-packages": [
    "moonbitlang/core/async",
    "moonbitlang/core/async/aqueue",
  ],
)
