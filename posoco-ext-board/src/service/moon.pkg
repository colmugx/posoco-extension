import {
  "colmugx/posoco",
  "colmugx/posoco-ext-board/backend",
  "colmugx/posoco-ext-board/coordinator",
  "colmugx/posoco-ext-board/domain",
  "colmugx/posoco-ext-board/dynamic",
  "colmugx/posoco-ext-board/execution",
  "colmugx/posoco-ext-board/execution/file" @journal,
  "colmugx/posoco-ext-board/expansion",
  "colmugx/posoco-ext-board/orchestration",
  "colmugx/posoco-ext-board/parallel",
  "colmugx/posoco-ext-board/protocol",
  "colmugx/posoco-ext-board/store",
  "colmugx/posoco-ext-board/workflow",
  "moonbitlang/core/async",
  "moonbitlang/core/debug",
}

// async/fs backs the native directory enumeration; the js twin uses node:fs.
#cfg(target = "native")
import {
  "moonbitlang/core/async/fs",
}

import {
  "colmugx/posoco/kernel",
  "colmugx/posoco-ext-board/testkit/node_fs" @fixtures,
  "moonbitlang/core/async",
} for "test"

import {
  "colmugx/posoco-ext-board/testkit/node_fs" @fixtures,
  "moonbitlang/core/async",
} for "wbtest"

supported_targets = "+native+js"

options(
  "allow-experimental-packages": [
    "moonbitlang/core/async",
    "moonbitlang/core/async/fs",
  ],
  targets: {
    "directory.native.mbt": [ "native" ],
    "directory.js.mbt": [ "js" ],
  },
)
