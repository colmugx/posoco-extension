// Target-specific native async/fs import is intentionally unused by JS files.
warnings = "-unused_package"

import {
  "moonbitlang/core/async/fs",
}

supported_targets = "+native+js"

options(
    "allow-experimental-packages": [ "moonbitlang/core/async/fs" ],
targets: { "fixtures.js.mbt": [ "js" ], "fixtures.native.mbt": [ "native" ] },
)
