import {
  "colmugx/posoco-ext-board/execution",
  "colmugx/posoco-ext-board/internal/storage" @node_fs,
  "moonbitlang/core/async",
}

// async/fs backs the native journal twins; the js twins use @node_fs.
#cfg(target = "native")
import {
  "moonbitlang/core/async/fs",
  "moonbitlang/core/encoding/utf8",
}

#cfg(target = "js")
import {
  "colmugx/posoco-ext-board/testkit/node_fs" @fixtures,
} for "test"

supported_targets = "+native+js"

options(
  "allow-experimental-packages": [
    "moonbitlang/core/async",
    "moonbitlang/core/async/fs",
  ],
  targets: {
    "store.native.mbt": [ "native" ],
    "store.js.mbt": [ "js" ],
    "inspect.native.mbt": [ "native" ],
    "inspect.js.mbt": [ "js" ],
    "store_js_test.mbt": [ "js" ],
    "store_native_test.mbt": [ "native" ],
  },
)
