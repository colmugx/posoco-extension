import {
  "colmugx/posoco-ext-board/execution/file",
  "colmugx/posoco-ext-board/execution",
}

import {
  "moonbitlang/core/async",
  "moonbitlang/core/async/fs",
  "colmugx/posoco-ext-board/backend",
  "colmugx/posoco-ext-board/store",
  "moonbitlang/core/async/aqueue",
  "colmugx/posoco",
  "colmugx/posoco/kernel",
  "moonbitlang/core/async" @core_async,
} for "test"

supported_targets = "native"

options(
  "allow-experimental-packages": [ "moonbitlang/core/async", "moonbitlang/core/async/aqueue", "moonbitlang/core/async/fs" ],
)
