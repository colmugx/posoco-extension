name = "colmugx/posoco-ext-board"

version = "0.1.0"

import {
  "colmugx/posoco@0.23.1",
  "colmugx/posoco-ext-askquestion@0.1.0",
  "colmugx/fuwaroid@0.3.2",
  "moonbitlang/async@0.22.5",
  "moonbitlang/x@0.5.5",
}

readme = "README.mbt.md"

license = "Apache-2.0"

repository = "https://github.com/colmugx/posoco-extension"

keywords = [ "posoco", "board", "orchestration", "realtime" ]

description = "Browser-native orchestration surface for Posoco"

source = "src"

preferred_target = "native"

supported_targets = "+native+js"
