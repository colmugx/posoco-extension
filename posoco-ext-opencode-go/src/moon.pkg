import {
  "colmugx/posoco",
  "colmugx/posoco-ext-opencode-zen" @zen,
  "colmugx/posoco-kit-deepseek" @dk,
  "posoco/devkit",
  "colmugx/posoco-kit-rate-limit" @ratelimit,
  "posoco/ext-llm" @llm,
  "posoco/ext-oauth" @oauth,
  "moonbitlang/async",
  "moonbitlang/async/http",
  "moonbitlang/core/debug",
  "moonbitlang/core/json",
}

import {
  "colmugx/posoco",
  "moonbitlang/async",
} for "wbtest"

warnings = "-unused_value-unused_constructor"

options(
  targets: {
    // HTTP-backed adaptors: native+wasm+js (moonbitlang/async/http is
    // unavailable on wasm-gc). Catalog/factory/protocol/limits/quota-parse
    // and the rate-limit decorator live in unrestricted core files; only
    // the live fetches compile on the HTTP backends.
    "models_native_js.mbt": [ "native", "wasm", "js" ],
    "quota_usage_native_js.mbt": [ "native", "wasm", "js" ],
    "rate_limit_native_js.mbt": [ "native", "wasm", "js" ],
    "refresh_native_js.mbt": [ "native", "wasm", "js" ],
    "opencode_go_wbtest.mbt": [ "native" ],
  },
)
