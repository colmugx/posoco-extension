import {
  "posoco/devkit",
  "colmugx/posoco",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/json",
  "moonbitlang/core/string",
  "moonbitlang/regexp",
}

// Per-backend filesystem walk: native+wasm through async/fs, js through the
// Bun FFI twin.
#cfg(not(target = "js"))
import {
  "moonbitlang/async/fs",
}

#cfg(target = "js")
import {
  "moonbitlang/async/js_async",
}

import {
  "moonbitlang/async",
} for "wbtest"

#cfg(target = "native")
import {
  "moonbitlang/async/fs",
  "colmugx/posoco/kernel",
} for "wbtest"

// `moonbitlang/async` is imported for the native-only white-box async tests,
// so js/wasm checks report it unused.

warnings = "-unused_package"

options(
  targets: {
    "posoco_ext_grep.js.mbt": [ "js" ],
    "posoco_ext_grep.native.mbt": [ "native", "wasm" ],
    "posoco_ext_grep_wbtest.mbt": [ "native" ],
  },
)
