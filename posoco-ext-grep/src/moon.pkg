import {
  "posoco/devkit",
  "colmugx/posoco",
  "moonbitlang/core/async/fs",
  "moonbitlang/core/async/js_async",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/json",
  "moonbitlang/core/string",
  "moonbitlang/regexp",
}

import {
  "moonbitlang/core/async",
  "moonbitlang/core/async/fs",
  "colmugx/posoco/kernel",
} for "wbtest"

warnings = "-unused_package"

options(
    "allow-experimental-packages": [ "moonbitlang/core/async", "moonbitlang/core/async/fs", "moonbitlang/core/async/js_async" ],
targets: {
    "posoco_ext_grep.js.mbt": [ "js" ],
    "posoco_ext_grep.native.mbt": [ "native", "wasm" ],
    "posoco_ext_grep_wbtest.mbt": [ "native" ],
  },
)
