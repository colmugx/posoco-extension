import {
  "posoco/devkit",
  "colmugx/posoco",
  "moonbitlang/async/fs",
  "moonbitlang/async/js_async",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/json",
  "moonbitlang/core/string",
}

import {
  "moonbitlang/async",
  "moonbitlang/async/fs",
  "colmugx/posoco/kernel",
} for "wbtest"

warnings = "-unused_package"

options(
  targets: {
    "posoco_ext_grep.js.mbt": [ "js" ],
    "posoco_ext_grep.native.mbt": [ "native", "wasm" ],
    "posoco_ext_grep_wbtest.mbt": [ "native" ],
  },
)
