name = "colmugx/posoco-ext-magpie"

version = "0.1.0"

readme = "README.mbt.md"

repository = "https://github.com/colmugx/posoco-extension"

license = "Apache-2.0"

keywords = [ "posoco", "magpie", "gateway", "model-manager", "control-plane" ]

description = "Posoco Magpie extension - independent Model Manager for the Magpie gateway: typed gateway configuration, catalog discovery, and ModelManagerControl selection"

source = "src"

import {
  "colmugx/posoco@0.22.1",
  "colmugx/posoco-kit-model-management@0.1.0",
  "moonbitlang/async@0.22.4",
}
