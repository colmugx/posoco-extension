import {
  "colmugx/posoco",
  "posoco/devkit",
}

import {
  "moonbitlang/async",
  "colmugx/posoco/kernel",
  "posoco/devkit/testkit" @tk,
} for "wbtest"

// `async test` requires the root `moonbitlang/async` import but never names it
// through the alias, so it always reads as unused.

warnings = "-unused_package"
