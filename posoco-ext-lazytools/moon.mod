name = "colmugx/posoco-ext-lazytools"

version = "0.1.0"

import {
  "colmugx/posoco@0.15.0",
  "colmugx/posoco-devkit@0.4.0",
  "moonbitlang/async@0.21.2",
}

readme = "README.mbt.md"

license = "Apache-2.0"

keywords = [ "posoco", "lazytools", "tool", "gateway", "deferred-loading" ]

description = "Posoco tool lazy-loading gateway - exposes search/list/execute meta tools and routes deferred calls to wrapped ToolProviders"

source = "src"
