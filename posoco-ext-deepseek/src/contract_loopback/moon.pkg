import {
  "colmugx/posoco",
  "colmugx/posoco-kit-provider" @provider,
  "colmugx/posoco-ext-deepseek",
  "posoco/devkit",
  "moonbitlang/core/async",
  "moonbitlang/core/async/http",
  "moonbitlang/core/async/socket",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/json",
} for "test"

supported_targets = "native"

options(
  "allow-experimental-packages": [ "moonbitlang/core/async", "moonbitlang/core/async/http", "moonbitlang/core/async/socket" ],
)
