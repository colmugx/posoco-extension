import {
  "colmugx/posoco",
  "colmugx/posoco-kit-provider" @provider,
  "colmugx/posoco-kit-deepseek" @dk,
  "posoco/devkit",
  "posoco/kit-chat-completions" @chatkit,
  "colmugx/posoco-kit-compact-evict" @evict,
  "posoco/ext-oauth" @oauth,
  "moonbitlang/core/async",
  "moonbitlang/core/async/http",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/debug",
  "moonbitlang/core/json",
}

import {
  "moonbitlang/core/async",
  "posoco/ext-llm" @llm,
} for "wbtest"

options(
  "allow-experimental-packages": [
    "moonbitlang/core/async",
    "moonbitlang/core/async/http",
  ],
  targets: {
    "posoco_ext_deepseek_wbtest.mbt": [ "native" ],
    "list_models_wbtest.mbt": [ "native" ],
    "balance_wbtest.mbt": [ "native" ],
    "pricing_wbtest.mbt": [ "native" ],
  },
)
