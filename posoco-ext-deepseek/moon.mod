name = "colmugx/posoco-ext-deepseek"

version = "0.2.0"

import {
  "colmugx/posoco@0.13.0",
  "colmugx/posoco-devkit@0.1.0",
  "colmugx/posoco-kit-chat-completions@0.1.0",
  "colmugx/posoco-ext-llm@0.1.0",
  "colmugx/posoco-ext-oauth@0.1.0",
  "moonbitlang/async@0.21.0",
}

readme = "README.mbt.md"

license = "Apache-2.0"

keywords = [
  "posoco",
  "deepseek",
  "llm",
  "model-port",
  "streaming",
  "fim",
  "prefix-cache",
]

description = "Posoco DeepSeek Extension - deep DeepSeek ModelPort with context cache, FIM, and prefix completion"

source = "src"
