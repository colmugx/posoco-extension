name = "colmugx/posoco-ext-zai-coding-plan"

version = "0.1.0"

import {
  "colmugx/posoco@0.14.3",
  "colmugx/posoco-ext-zai@0.1.0",
  "colmugx/posoco-devkit@0.3.0",
  "colmugx/posoco-ext-llm@0.2.0",
  "colmugx/posoco-ext-oauth@0.1.0",
  "moonbitlang/async@0.21.0",
}

readme = "README.mbt.md"

license = "Apache-2.0"

keywords = [
  "posoco",
  "zai",
  "bigmodel",
  "glm",
  "coding-plan",
  "llm",
  "model-port",
]

description = "Posoco GLM Coding Plan extension - coding-plan endpoint presets over the shared GLM protocol, with typed 429 quota verdicts"

source = "src"
