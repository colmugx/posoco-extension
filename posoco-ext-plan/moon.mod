name = "colmugx/posoco-ext-plan"

version = "0.3.0"

import {
  "colmugx/posoco@0.18.5",
  "colmugx/posoco-devkit@0.4.0",
  "colmugx/posoco-ext-workspace@0.1.0",
  "moonbitlang/async@0.22.3",
}

readme = "README.mbt.md"

license = "Apache-2.0"

keywords = [ "posoco", "plan", "plan-mode", "read-only", "ai-agent" ]

description = "Plan mode extension for Posoco: read-only tool gating, per-turn plan reminders, and an exit-plan approval flow"

source = "src"
