import {
  "colmugx/posoco",
  "colmugx/posoco/kernel",
  "posoco/devkit",
  "posoco/kit-events" @kit_events,
  "colmugx/posoco-ext-lazytools" @lazytools,
  "colmugx/posoco-ext-workspace" @workspace,
  "moonbitlang/core/debug",
}

import {
  "moonbitlang/core/async",
} for "test"

import {
  "moonbitlang/core/async",
} for "wbtest"

supported_targets = "+native +js"

options(
  "allow-experimental-packages": [ "moonbitlang/core/async" ],
)
