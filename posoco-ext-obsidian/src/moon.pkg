import {
  "colmugx/posoco",
  "posoco/devkit",
  "moonbitlang/core/debug",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/json",
  "moonbitlang/core/string",
}

// Per-backend CLI runner: native+wasm spawn through @process, js through the
// Bun FFI twin.
#cfg(not(target = "js"))
import {
  "moonbitlang/core/async/process",
}

#cfg(target = "js")
import {
  "moonbitlang/core/async/js_async",
}

import {
  "moonbitlang/core/async",
} for "wbtest"

supported_targets = "+native +js"

options(
  "allow-experimental-packages": [
    "moonbitlang/core/async",
    "moonbitlang/core/async/js_async",
    "moonbitlang/core/async/process",
  ],
  targets: {
    "posoco_ext_obsidian.native.mbt": [ "native", "wasm" ],
    "posoco_ext_obsidian.js.mbt": [ "js" ],
  },
)
