import {
  "colmugx/posoco",
  "posoco/devkit",
  "moonbitlang/core/async/process",
  "moonbitlang/core/async/js_async",
  "moonbitlang/core/debug",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/json",
  "moonbitlang/core/string",
}

import {
  "moonbitlang/core/async",
} for "wbtest"

warnings = "-unused_package"

supported_targets = "+native +js"

options(
    "allow-experimental-packages": [ "moonbitlang/core/async", "moonbitlang/core/async/js_async", "moonbitlang/core/async/process" ],
targets: {
    "posoco_ext_obsidian.native.mbt": [ "native", "wasm" ],
    "posoco_ext_obsidian.js.mbt": [ "js" ],
  },
)
