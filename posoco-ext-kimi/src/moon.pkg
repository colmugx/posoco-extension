import {
  "colmugx/posoco",
  "posoco/devkit",
  "colmugx/posoco-kit-rate-limit" @ratelimit,
  "posoco/kit-chat-completions" @chatkit,
  "colmugx/posoco-kit-compact-summary" @compact_summary,
  "colmugx/posoco-kit-responses" @responses,
  "posoco/ext-llm" @llm,
  "posoco/ext-oauth" @oauth,
  "moonbitlang/core/async",
  "moonbitlang/core/async/http",
  "moonbitlang/core/debug",
  "moonbitlang/core/json",
  "moonbitlang/core/random",
  "moonbitlang/core/string",
}

// UTF-8 decoding backs the native identity probe.
#cfg(target = "native")
import {
  "moonbitlang/core/encoding/utf8",
}

import {
  "moonbitlang/core/async",
} for "wbtest"

#cfg(target = "native")
import {
  "moonbitlang/core/env",
} for "wbtest"

options(
  "allow-experimental-packages": [ "moonbitlang/core/async", "moonbitlang/core/async/http" ],
  "native-stub": [ "identity_stub.c" ],
  targets: {
    "identity.js.mbt": [ "js" ],
    "identity.native.mbt": [ "native" ],
    "posoco_ext_kimi_wbtest.mbt": [ "native" ],
    "usage_wbtest.mbt": [ "native" ],
  },
)
