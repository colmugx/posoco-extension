import {
  "moonbitlang/core/encoding/utf8",
  "colmugx/posoco",
  "moonbitlang/core/async",
  "moonbitlang/core/debug",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
}

// task.native.mbt is the only consumer of the native process/filesystem
// stack; task.js.mbt uses the Bun FFI twin.
#cfg(target = "native")
import {
  "moonbitlang/core/async/aqueue",
  "moonbitlang/core/async/fs",
  "moonbitlang/core/async/io",
  "moonbitlang/core/async/process",
}

#cfg(target = "js")
import {
  "moonbitlang/core/async/js_async",
}

import {
  "colmugx/posoco/kernel",
  "posoco/devkit/testkit" @tk,
} for "wbtest"

supported_targets = "+native +js"

// `@env` is only reached from white-box test files, whose imports never clear
// the main-package unused check; js checks report it unused.

warnings = "-unused_package"

options(
  "allow-experimental-packages": [ "moonbitlang/core/async", "moonbitlang/core/async/aqueue", "moonbitlang/core/async/fs", "moonbitlang/core/async/io", "moonbitlang/core/async/js_async", "moonbitlang/core/async/process" ],
  targets: {
    "task.native.mbt": [ "native" ],
    "task.js.mbt": [ "js" ],
    "live_wbtest.mbt": [ "native" ],
  },
)
