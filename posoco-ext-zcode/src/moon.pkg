import {
  "colmugx/posoco",
  "moonbitlang/core/async",
  "moonbitlang/core/async/aqueue",
  "moonbitlang/core/async/fs",
  "moonbitlang/core/async/io",
  "moonbitlang/core/async/js_async",
  "moonbitlang/core/async/process",
  "moonbitlang/core/debug",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
}

import {
  "colmugx/posoco/kernel",
  "posoco/devkit/testkit" @tk,
} for "wbtest"

supported_targets = "+native +js"

// @fs/@io/@process serve only task.native.mbt and @js_async only
// task.js.mbt, so each target sees unused imports.

warnings = "-unused_package"

options(
    "allow-experimental-packages": [ "moonbitlang/core/async", "moonbitlang/core/async/aqueue", "moonbitlang/core/async/fs", "moonbitlang/core/async/io", "moonbitlang/core/async/js_async", "moonbitlang/core/async/process" ],
targets: {
    "task.native.mbt": [ "native" ],
    "task.js.mbt": [ "js" ],
    "live_wbtest.mbt": [ "native" ],
  },
)
