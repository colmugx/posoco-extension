import {
  "colmugx/posoco",
  "colmugx/posoco/kernel",
  "moonbitlang/core/async",
  "moonbitlang/core/async/http",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/json",
  "moonbit-community/html",
}

import {
  "moonbitlang/core/async",
} for "wbtest"

warnings = "-unused_package"

options(
    "allow-experimental-packages": [ "moonbitlang/core/async", "moonbitlang/core/async/http" ],
targets: {
    "posoco_ext_webfetch_wbtest.mbt": [ "native" ],
    "http_io.mbt": [ "native", "wasm", "js" ],
    "posoco_ext_webfetch.mbt": [ "native", "wasm", "js" ],
  },
)
