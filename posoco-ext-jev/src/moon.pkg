import {
  "colmugx/posoco",
  "colmugx/posoco-ext-oauth" @oauth,
  "moonbitlang/async",
  "moonbitlang/async/http",
  "moonbitlang/core/json",
}

warnings = "-unused_package-unused_value-unused_constructor"

options(
  targets: {
    "decision_native_js.mbt": [ "native", "wasm", "js" ],
    "decision_wasm_fallback.mbt": [ "wasm-gc" ],
    "jev_wbtest.mbt": [ "native" ],
  },
)
