name = "colmugx/posoco-ext-acp"

version = "0.1.0"

import {
  "colmugx/posoco@0.10.1",
  "colmugx/acp@0.1.2",
  "colmugx/posoco-devkit@0.1.0",
  "moonbitlang/async@0.20.5",
}

readme = "README.mbt.md"

license = "Apache-2.0"

keywords = [ "posoco", "acp", "agent-client-protocol", "zed", "editor" ]

description = "Posoco ACP extension - projects turn events to ACP v1 session updates and gates tools through ACP permission requests"

source = "src"

preferred_target = "native"
