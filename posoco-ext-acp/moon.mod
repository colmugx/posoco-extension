name = "colmugx/posoco-ext-acp"

version = "0.2.0"

import {
  "colmugx/posoco@0.12.0",
  "colmugx/acp@0.1.3",
  "colmugx/posoco-devkit@0.1.0",
  "colmugx/posoco-ext-permission@0.2.0",
  "moonbitlang/async@0.21.0",
}

readme = "README.mbt.md"

license = "Apache-2.0"

keywords = [ "posoco", "acp", "agent-client-protocol", "zed", "editor" ]

description = "Posoco ACP extension - projects turn events to ACP v1 session updates and translates permission asks into ACP permission requests"

source = "src"

preferred_target = "native"
