import {
  "colmugx/posoco",
  "posoco/devkit",
  "moonbitlang/async/fs",
  "moonbitlang/core/json",
}

// No per-file targets: each file uses #cfg attributes for conditional
// compilation. All files compile on every target; inactive #cfg branches
// are simply excluded by the compiler.

import {
  "moonbitlang/async",
  "colmugx/posoco/kernel",
} for "wbtest"

warnings = "-unused_package"

options(
  targets: {
    "posoco_ext_edit.js.mbt": [ "js" ],
    "posoco_ext_edit.native.mbt": [ "native", "wasm" ],
  },
)
