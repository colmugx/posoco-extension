import {
  "colmugx/posoco",
  "posoco/devkit",
}

// async/fs backs the native editor; the js twin uses node:fs and only needs
// the JSON wire vocabulary.
#cfg(not(target = "js"))
import {
  "moonbitlang/core/async/fs",
  // UTF-8 decoding backs the native/wasm read path only.
  "moonbitlang/core/encoding/utf8",
}

#cfg(target = "js")
import {
  "moonbitlang/core/json",
}

// No per-file targets: each file uses #cfg attributes for conditional
// compilation. All files compile on every target; inactive #cfg branches
// are simply excluded by the compiler.

import {
  "moonbitlang/core/async",
  "colmugx/posoco/kernel",
} for "wbtest"

options(
  "allow-experimental-packages": [
    "moonbitlang/core/async",
    "moonbitlang/core/async/fs",
  ],
  targets: {
    "posoco_ext_edit.js.mbt": [ "js" ],
    "posoco_ext_edit.native.mbt": [ "native", "wasm" ],
  },
)
