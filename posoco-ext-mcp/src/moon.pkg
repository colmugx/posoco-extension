import {
  "colmugx/posoco",
  "colmugx/posoco/kernel",
  "colmugx/posoco/runtime",
  "posoco/devkit",
  "colmugx/mcp/client",
  "colmugx/mcp/transport",
  "colmugx/mcp/protocol/types",
  "colmugx/fuwaroid",
  "moonbitlang/core/async",
  "moonbitlang/core/async/fs",
  "moonbitlang/core/async/js_async",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
}

supported_targets = "+native+js"

// js gates out the async/fs read path, so the import is unused on that
// target; the warning cannot be suppressed per-target.

warnings = "-unused_package"

options(
    "allow-experimental-packages": [ "moonbitlang/core/async", "moonbitlang/core/async/fs", "moonbitlang/core/async/js_async" ],
targets: {
    "config_wbtest.mbt": [ "native" ],
    "resilience_e2e_wbtest.mbt": [ "native" ],
  },
)
