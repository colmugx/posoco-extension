import {
  "colmugx/posoco",
  "colmugx/posoco/kernel",
  "colmugx/posoco/runtime",
  "posoco/devkit",
  "colmugx/mcp/client",
  "colmugx/mcp/transport",
  "colmugx/mcp/protocol/types",
  "colmugx/fuwaroid",
  "moonbitlang/async",
  "moonbitlang/async/aqueue",
  "moonbitlang/core/async" @core_async,
  "moonbitlang/core/env",
  "moonbitlang/core/json",
}

// async/fs backs the native config reader; the js twin reads through the
// node:fs envelope.
#cfg(not(target = "js"))
import {
  "moonbitlang/core/async/fs",
}

#cfg(target = "native")
import {
  "moonbitlang/core/encoding/utf8",
}

supported_targets = "+native+js"

options(
  "allow-experimental-packages": [
    "moonbitlang/core/async",
    "moonbitlang/core/async/fs",
  ],
  targets: {
    "config_wbtest.mbt": [ "native" ],
    "resilience_e2e_wbtest.mbt": [ "native" ],
  },
)
