name = "colmugx/posoco-ext-session-bridge"

version = "0.1.0"

import {
  "colmugx/posoco@0.24.2",
}

readme = "README.mbt.md"

license = "Apache-2.0"

repository = "https://github.com/colmugx/posoco-extension"

keywords = [ "posoco", "session", "bridge", "ipc", "multi-surface" ]

description = "Host-neutral Session snapshot/event continuity for local Posoco multi-surface adapters"

source = "src"

supported_targets = "+native +js"
