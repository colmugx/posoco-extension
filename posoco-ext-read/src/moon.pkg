import {
  "colmugx/posoco",
  "posoco/devkit",
  "colmugx/posoco-ext-workspace" @workspace,
  "moonbitlang/core/encoding/utf8",
}

// async/fs and the base64 codec back the native reader; the js twin uses
// node:fs and only needs the JSON wire vocabulary.
#cfg(not(target = "js"))
import {
  "moonbitlang/core/async/fs",
  "moonbitlang/core/encoding/base64",
}

#cfg(target = "js")
import {
  "moonbitlang/core/json",
}

import {
  "moonbitlang/core/async",
  "colmugx/posoco-ext-workspace" @workspace,
} for "wbtest"

#cfg(target = "native")
import {
  "colmugx/posoco/kernel",
} for "wbtest"

// `moonbitlang/core/async` is imported for the native-only white-box async
// tests above, so js/wasm checks report it unused.

warnings = "-unused_package"

options(
  "allow-experimental-packages": [ "moonbitlang/core/async", "moonbitlang/core/async/fs" ],
  targets: {
    "posoco_ext_read.js.mbt": [ "js" ],
    "posoco_ext_read.native.mbt": [ "native", "wasm" ],
  },
)
