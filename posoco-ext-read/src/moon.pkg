import {
  "moonbitlang/core/async/fs",
  "moonbitlang/core/async/io",
  "colmugx/posoco",
  "posoco/devkit",
  "colmugx/posoco-ext-workspace" @workspace,
  "moonbitlang/core/encoding/base64",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/json",
}

import {
  "moonbitlang/core/async",
  "colmugx/posoco-ext-workspace" @workspace,
  "colmugx/posoco/kernel",
} for "wbtest"

warnings = "-unused_package"

options(
    "allow-experimental-packages": [ "moonbitlang/core/async", "moonbitlang/core/async/fs", "moonbitlang/core/async/io" ],
targets: {
    "posoco_ext_read.js.mbt": [ "js" ],
    "posoco_ext_read.native.mbt": [ "native", "wasm" ],
  },
)
