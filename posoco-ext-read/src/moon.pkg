import {
  "moonbitlang/async/fs",
  "colmugx/posoco",
  "colmugx/posoco-devkit" @devkit,
  "colmugx/posoco-ext-workspace" @workspace,
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/json",
}

import {
  "moonbitlang/async",
  "colmugx/posoco-ext-workspace" @workspace,
} for "wbtest"

warnings = "-unused_package"

options(
  targets: {
    "posoco_ext_read.js.mbt": [ "js" ],
    "posoco_ext_read.native.mbt": [ "native" ],
  },
)
