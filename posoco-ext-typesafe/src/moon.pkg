import {
  "colmugx/posoco",
  "colmugx/posoco-kit-provider" @provider,
  "posoco/ext-oauth" @oauth,
  "moonbitlang/core/async",
  "moonbitlang/core/async/http",
  "moonbitlang/core/json",
  "moonbitlang/core/debug",
}

warnings = "-unused_value-unused_constructor"

options(
  "allow-experimental-packages": [ "moonbitlang/core/async", "moonbitlang/core/async/http" ],
  targets: {
    "decision_native_js.mbt": [ "native", "wasm", "js" ],
    "decision_wasm_fallback.mbt": [ "wasm-gc" ],
    "jev_wbtest.mbt": [ "native" ],
    "provider_factory_wbtest.mbt": [ "native" ],
  },
)
