import {
  "colmugx/posoco",
  "posoco/devkit",
  "colmugx/posoco-kit-rate-limit" @ratelimit,
  "colmugx/posoco-kit-messages" @messages,
  "colmugx/posoco-kit-compact-summary" @compact_summary,
  "posoco/ext-llm" @llm,
  "posoco/ext-oauth" @oauth,
  "moonbitlang/core/async",
  "moonbitlang/core/async/http",
  "moonbitlang/core/debug",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/json",
}

import {
  "colmugx/posoco",
  "moonbitlang/core/async",
  "moonbitlang/core/async/http",
  "moonbitlang/core/async/socket",
} for "wbtest"

// `@socket` is only reached from white-box test files, whose imports never
// clear the main-package unused check.

warnings = "-unused_package"

options(
  "allow-experimental-packages": [
    "moonbitlang/core/async",
    "moonbitlang/core/async/http",
    "moonbitlang/core/async/socket",
  ],
  targets: {
    "zai_wbtest.mbt": [ "native" ],
    "zai_retry_wbtest.mbt": [ "native" ],
    "posoco_ext_zai_wbtest.mbt": [ "native" ],
    "list_models_wbtest.mbt": [ "native" ],
  },
)
