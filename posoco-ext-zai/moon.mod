keywords = [
  "posoco",
  "zai",
  "bigmodel",
  "glm",
  "coding-plan",
  "llm",
  "model-port",
]

description = "Posoco Z.ai (bigmodel) GLM extension - coding-plan endpoint presets, GLM thinking/reasoning_effort, and typed 429 quota verdicts"

source = "src"
