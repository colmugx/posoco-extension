name = "colmugx/posoco-ext-zai"

version = "0.1.0"

import {
  "colmugx/posoco@0.22.3",
  "posoco/devkit@0.4.1",
  "colmugx/posoco-kit-rate-limit@0.1.0",
  "colmugx/posoco-kit-messages@0.1.0",
  "colmugx/posoco-kit-compact-summary@0.1.0",
  "posoco/ext-llm@0.2.0",
  "posoco/ext-oauth@0.1.0",
  "moonbitlang/async@0.22.5",
}

readme = "README.mbt.md"

license = "Apache-2.0"

keywords = [ "posoco", "zai", "bigmodel", "glm", "llm", "model-port" ]

description = "Posoco Z.ai / BigModel GLM extension - direct platform API access with platform-choice login, GLM thinking/reasoning_effort, and typed 429 quota verdicts"

source = "src"
