import {
  "colmugx/posoco",
  "colmugx/posoco/kernel",
  "posoco/devkit",
  "moonbitlang/core/debug",
  "moonbitlang/core/json",
}

import {
  "moonbitlang/core/async",
  "posoco/devkit/testkit" @tk,
} for "wbtest"

warnings = "-unused_package"

options(
  "allow-experimental-packages": [ "moonbitlang/core/async" ],
  targets: {
    "posoco_ext_goal_wbtest.mbt": [ "native" ],
    "gate_loop_wbtest.mbt": [ "native" ],
    "composition_wbtest.mbt": [ "native" ],
  },
)
