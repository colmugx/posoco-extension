import {
  "colmugx/posoco",
  "colmugx/posoco/kernel",
  "colmugx/posoco/runtime",
  "colmugx/posoco-ext-mbtx" @mbtx,
  "colmugx/posoco-ext-mbtx/protocol",
  "moonbitlang/core/debug",
  "posoco/devkit",
}

import {
  "moonbitlang/core/async",
  "posoco/devkit/testkit" @tk,
} for "test"

supported_targets = "native + js"

options(
  "allow-experimental-packages": [ "moonbitlang/core/async" ],
)
