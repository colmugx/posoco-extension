import {
  "colmugx/posoco",
  "posoco/kit-events" @kit_events,
  "posoco/devkit",
  "moonbitlang/core/debug",
}

import {
  "moonbitlang/core/async",
} for "wbtest"

// Both tests are native-only white-box files.
#cfg(target = "native")
import {
  "colmugx/posoco/events",
  "posoco/devkit/testkit" @tk,
} for "wbtest"

// `async test` requires the root `moonbitlang/core/async` import, and a test import
// cannot be target-gated, so js/wasm checks report it unused.

warnings = "-unused_package"

options(
  "allow-experimental-packages": [ "moonbitlang/core/async" ],
  targets: {
    "statusbar_wbtest.mbt": [ "native" ],
    "command_statusbar_wbtest.mbt": [ "native" ],
  },
)
