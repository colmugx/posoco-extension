import {
  "colmugx/posoco",
  "posoco/devkit",
  "colmugx/posoco-kit-rate-limit" @ratelimit,
  "colmugx/posoco-kit-deepseek" @ds,
  "colmugx/posoco-ext-opencode-zen/compatible",
  "colmugx/posoco-kit-messages" @messages,
  "colmugx/posoco-kit-responses" @responses,
  "posoco/ext-llm" @llm,
  "posoco/ext-oauth" @oauth,
  "posoco/kit-chat-completions" @chatkit,
  "colmugx/posoco-kit-compact-summary" @compact_summary,
  "moonbitlang/async",
  "moonbitlang/async/http",
  "moonbitlang/core/debug",
  "moonbitlang/core/json",
  "moonbitlang/core/random",
}

import {
  "colmugx/posoco",
  "moonbitlang/async",
} for "wbtest"

warnings = "-unused_value-unused_constructor"

options(
  targets: {
    // HTTP-backed adaptors: native+wasm+js (moonbitlang/async/http is
    // unavailable on wasm-gc). The pure decoders (parse_zen_models,
    // parse_models_dev_meta), ZenModelInfo, the catalog builders, the
    // factory (build/login/provider_id), the static catalog path, the
    // protocol table, and the zen-owned wire layer (config, encode, decode,
    // SSE wrapper, error classification, provider_config) live in
    // unrestricted core files and compile on every backend. The three
    // per-wire transports (chat completions, messages, responses) and the
    // refresh/models.dev fetch compile on native+wasm+js.
    "chat_native_js.mbt": [ "native", "wasm", "js" ],
    "wire_messages_native_js.mbt": [ "native", "wasm", "js" ],
    "wire_responses_native_js.mbt": [ "native", "wasm", "js" ],
    "compact_native_js.mbt": [ "native", "wasm", "js" ],
    "models_native_js.mbt": [ "native", "wasm", "js" ],
    "refresh_native_js.mbt": [ "native", "wasm", "js" ],
    "wire_log.js.mbt": [ "js" ],
    "wire_log_native.mbt": [ "native", "wasm" ],
    "opencode_zen_wbtest.mbt": [ "native" ],
  },
)
