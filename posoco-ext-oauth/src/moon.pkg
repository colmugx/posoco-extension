import {
  "moonbitlang/core/async",
  "moonbitlang/core/async/http",
  "moonbitlang/core/async/socket",
  "moonbitlang/core/async/js_async",
  "moonbitlang/core/debug",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/json",
  "moonbitlang/x/crypto",
}

warnings = "-unused_package"

options(
    "allow-experimental-packages": [ "moonbitlang/core/async", "moonbitlang/core/async/http", "moonbitlang/core/async/js_async", "moonbitlang/core/async/socket" ],
"native-stub": [ "entropy_stub.c" ],
  targets: {
    "callback_server.native.mbt": [ "native" ],
    "callback_server.js.mbt": [ "js" ],
    "device_flow_wbtest.mbt": [ "native" ],
    "entropy.native.mbt": [ "native" ],
    "entropy.js.mbt": [ "js" ],
    "browser_flow_wbtest.mbt": [ "native" ],
  },
)
