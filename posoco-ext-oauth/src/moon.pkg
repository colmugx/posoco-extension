import {
  "moonbitlang/async",
  "moonbitlang/async/http",
  "moonbitlang/async/socket",
  "moonbitlang/async/js_async",
  "moonbitlang/core/json",
  "moonbitlang/x/crypto",
}

warnings = "-unused_package"

options(
  targets: {
    "credential.mbt": [ "native", "js" ],
    "credential_store.mbt": [ "native", "js" ],
    "oauth_provider.mbt": [ "native", "js" ],
    "oauth_error.mbt": [ "native", "js" ],
    "auth_interaction.mbt": [ "native", "js" ],
    "pkce.mbt": [ "native", "js" ],
    "device_flow.mbt": [ "native", "js" ],
    "callback_server.mbt": [ "native", "js" ],
    "callback_server.native.mbt": [ "native" ],
    "callback_server.js.mbt": [ "js" ],
  },
)
