import {
  "colmugx/posoco",
  "colmugx/fuwaroid",
  "moonbitlang/core/debug",
  "posoco/devkit",
  "colmugx/posoco-kit-subagent" @kit,
  "colmugx/posoco-ext-kind" @kind,
  "colmugx/posoco-ext-permission" @permission,
  "moonbitlang/async",
}

// @runtime (PortRuntime harness), @error (CompositionError) and @kernel
// (EffectId for ToolCallContext literals) serve only the whitebox async tests.
import {
  "colmugx/posoco/runtime",
  "colmugx/posoco/error",
  "colmugx/posoco/kernel",
} for "wbtest"

warnings = "-unused_package"

// These async tests share task-group lifecycle scheduling under the JS runner.
// Run them one at a time to prevent cross-test cancellation races.
options(
  "max-concurrent-tests": 1,
)
